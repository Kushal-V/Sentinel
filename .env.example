# .env.example — Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# Groq API Key (required for all LLM calls — Dispatcher, Specialists, Analyst)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Phase 4 Migration Flag (optional) ---
# Set to true (or 1, yes, on) to route specialist agents through the new
# LangGraph StateGraph instead of the legacy manual ReAct loop. The two
# paths are designed to be functionally equivalent; this flag exists for
# safe staged rollout. Defaults to false (legacy loop) until parity has
# been verified in staging.
# SENTINEL_USE_LANGGRAPH=false

# --- Observability (optional) ---
# Set both keys to enable Langfuse LLM tracing. Get them at https://cloud.langfuse.com
# When both are present, every ChatGroq call (dispatcher, specialist, analyst,
# inter-agent consultation) auto-emits structured traces with token counts,
# latency, prompt/completion text, and cost. Sentinel runs identically when
# these are absent — the observability layer is a zero-overhead no-op.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- F4 — Confidence-routed auto-commit ("human-on-the-loop") ---
# Set to true (or 1, yes, on) to enable autonomous commits when ALL three
# thresholds hold:
#   - agent self-rated confidence >= AUTO_COMMIT_CONFIDENCE_THRESHOLD (0.85)
#   - agent trust score           >= AUTO_COMMIT_TRUST_THRESHOLD       (0.80)
#   - |delta| / |current_value|   <= AUTO_COMMIT_MAX_DELTA_FRACTION    (0.05)
# Otherwise the change is held for human approval as before. Sandbox
# re-validation runs at commit time regardless of the gate. See
# src/core/config.py to tune the numeric thresholds.
# Defaults to false — opt-in for safety; existing deployments are byte-
# identical until you flip this on.
# SENTINEL_AUTO_COMMIT_ENABLED=false

# --- F5 — Conversation-level guardrails (regex jailbreak + PII redaction) ---
# Default: enabled. Set to false to disable (e.g., for development).
# Wraps the dispatcher INPUT (jailbreak / prompt-injection regex, length cap)
# and specialist / analyst OUTPUT (PII + secret-leak redaction). The layer is
# conservative so it stays safe-on-by-default in production. Disable only if
# regex false-positives are blocking legitimate domain-specific inputs.
# SENTINEL_GUARDRAILS_ENABLED=true
