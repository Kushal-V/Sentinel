# .env.example — Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# Groq API Key (required for all LLM calls — Dispatcher, Specialists, Analyst)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Observability (optional) ---
# Set both keys to enable Langfuse LLM tracing. Get them at https://cloud.langfuse.com
# When both are present, every ChatGroq call (dispatcher, specialist, analyst,
# inter-agent consultation) auto-emits structured traces with token counts,
# latency, prompt/completion text, and cost. Sentinel runs identically when
# these are absent — the observability layer is a zero-overhead no-op.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
